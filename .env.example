MODEL_PATH=/app/models/mobilenetv2_inference.pth
API_KEY=change-me-before-production
INTERNAL_API_KEY=change-me-internal-service-secret
AWS_REGION=eu-north-1
ENABLE_CLOUDWATCH=0
CPU_LIMIT=2

# Dashboard data source: "local" (default) reads from disk; "s3" reads from S3
DATA_SOURCE=local
# Required when DATA_SOURCE=s3 — the name of the S3 bucket
S3_BUCKET=

# RabbitMQ message broker credentials
RABBITMQ_USER=guest
RABBITMQ_PASS=change-me-in-production